# Local development persistence. Filesystem is the zero-credential default.
VORTEX_DATA_DIR=.data
VORTEX_DATABASE=sqlite
VORTEX_OBJECT_STORE=filesystem

# Reserved for the documented PostgreSQL migration path. The runtime currently
# fails closed if selected because the production repository adapter is not complete.
VORTEX_DATABASE_URL=

# Required in production. Generate at least 32 random bytes and encode base64url.
VORTEX_GUEST_COOKIE_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# S3-compatible private object storage (Cloudflare R2 uses region "auto").
# VORTEX_OBJECT_STORE=s3
VORTEX_S3_ENDPOINT=
VORTEX_S3_REGION=auto
VORTEX_S3_BUCKET=
VORTEX_S3_ACCESS_KEY_ID=
VORTEX_S3_SECRET_ACCESS_KEY=

# Optional comma-separated user IDs for initial operator grant bootstrap.
VORTEX_OPERATOR_USER_IDS=

# Bounded onboarding runner. Defaults to product-onboarding/.venv/bin/python.
VORTEX_ONBOARDING_PYTHON=
VORTEX_ONBOARDING_TIMEOUT_MS=300000
