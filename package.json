{
  "name": "vortex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D packaging configurator and structural carton engine: production dielines to exact folding geometry, artwork mapping and print-ready output",
  "author": "Iamanshuaditya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Iamanshuaditya/3d.git"
  },
  "homepage": "https://github.com/Iamanshuaditya/3d",
  "bugs": {
    "url": "https://github.com/Iamanshuaditya/3d/issues"
  },
  "keywords": [
    "packaging",
    "dieline",
    "folding-carton",
    "3d",
    "threejs",
    "nextjs",
    "structural-engine",
    "print"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:pdf": "node scripts/validate-production-pdf.mjs",
    "verify:golden-structure": "tsx scripts/verify-golden-structure.ts",
    "inspect:golden-construction": "tsx scripts/inspect-golden-construction.ts",
    "verify:golden-local": "tsx scripts/verify-golden-local.ts",
    "verify:golden-reference": "tsx scripts/verify-golden-reference-recreation.ts",
    "finalize:golden-reference": "tsx scripts/finalize-golden-reference.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "build:standalone": "node scripts/package-standalone.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "capture:golden-reference": "tsx scripts/capture-golden-reference.ts",
    "capture:product-experience": "tsx scripts/capture-product-experience.ts",
    "experimental:cloudflare-build": "opennextjs-cloudflare build",
    "experimental:cloudflare-preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dxf-parser": "^1.1.2",
    "konva": "^10.3.0",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "saxes": "^6.0.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
